; One-time account-link diagnostic. Merge into the existing [network_mitm]
; section; do not replace the entire system_settings.ini file.
[network_mitm]
enable_ssl = u8!0x1
targeted_device_pki_mode = u8!0x1
; Keep the hardware-verified NIM ssl:s fallback, the statically proven Account ssl:s path,
; and the hardware-observed NPNS ssl:s path restricted to these three exact IDs.
mitm_program_ids = str!0100000000000025 010000000000001E 010000000000002F
trace_internal_pki = u8!0x1
enable_device_cert_fallback = u8!0x1
device_cert_fallback_program_ids = str!0100000000000025 010000000000001E 010000000000002F
; Ordinary ssl MITM is disabled in this build after the observed 0xFFFE module abort.
; Keep this stale compatibility setting off.
enable_account_link_diagnostic = u8!0x0
should_mitm_all = u8!0x0
should_dump_ssl_traffic = u8!0x0
should_disable_ssl_verification = u8!0x0
; Do not add custom_ca_public_cert or alter Prelude hosts/trust settings.
